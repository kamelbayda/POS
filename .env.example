# Licence server (super-app-backend) used to activate and re-check licences.
# e.g. https://your-backend.up.railway.app
VITE_LICENSE_SERVER_URL=

# Public key that verifies signed licences (base64 SPKI).
# Generate the key pair in super-app-backend with: npm run generate-license-keys
# This one is public and is built into the app; the private key stays on the server.
VITE_LICENSE_PUBLIC_KEY=

# Set to "production" to serve the built files from dist/ instead of Vite.
# NODE_ENV=production

# Electron dev window URL (defaults to http://localhost:3000).
# ELECTRON_DEV_URL=http://localhost:3000

# "true" to use the local Firebase emulators (npm run emulators) instead of the real project.
# VITE_FIREBASE_EMULATOR=true
