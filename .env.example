# Licence server (super-app-backend/worker on Cloudflare), e.g. https://pos-licensing.<account>.workers.dev
# Easiest: open <server>/admin, sign in, and press "copy app settings (.env)" to get both lines below.
VITE_LICENSE_SERVER_URL=

# Public key that verifies signed licences (base64 SPKI). Public, built into the app;
# the private key never leaves the server. Also available at <server>/api/licenses/public-key
VITE_LICENSE_PUBLIC_KEY=

# Set to "production" to serve the built files from dist/ instead of Vite.
# NODE_ENV=production

# Electron dev window URL (defaults to http://localhost:3000).
# ELECTRON_DEV_URL=http://localhost:3000

# "true" to use the local Firebase emulators (npm run emulators) instead of the real project.
# VITE_FIREBASE_EMULATOR=true
