# No server-side secrets are required to run the app.
#
# The Gemini API key for the AI assistant is entered by the user in the app's
# settings screen and stored locally on that device (never commit a real key).

# Set to "production" to serve the built files from dist/ instead of Vite.
# NODE_ENV=production

# Electron dev window URL (defaults to http://localhost:3000).
# ELECTRON_DEV_URL=http://localhost:3000
